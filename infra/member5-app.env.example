# Copy/merge these variables into the server-only /data/lingow-member5/infra/.env.
# Do not commit the resulting file or print it in deployment logs.

POSTGRES_DB=lingow
POSTGRES_USER=lingow_member5
POSTGRES_PASSWORD=replace-with-the-existing-server-secret
VALKEY_PASSWORD=replace-with-the-existing-server-secret
# Percent-encoded versions used only in the application URLs below. If the
# passwords are generated with `openssl rand -hex`, these values are identical
# to the raw passwords. Keep both values server-local.
POSTGRES_PASSWORD_URLENCODED=replace-with-url-encoded-postgres-password
VALKEY_PASSWORD_URLENCODED=replace-with-url-encoded-valkey-password

# The server layout keeps this Compose file in infra/ and the source checkout
# in ../source/. For a checkout where infra/ is inside the repository root,
# override this with LINGOW_SOURCE_DIR=.. when invoking Compose.
LINGOW_SOURCE_DIR=../source
LINGOW_DOCKERFILE=services/api/Dockerfile
# Select a reachable Go module proxy for the build host when the default
# proxy.golang.org endpoint is unavailable.
LINGOW_GOPROXY=https://mirrors.tencent.com/go,direct

# At least 32 bytes. Generate independently from the database passwords.
LINGOW_TOKEN_SECRET=replace-with-a-random-32-byte-or-longer-secret
# At least 32 bytes. Keep this independent from LINGOW_TOKEN_SECRET; changing
# it requires a deliberate credential-digest migration plan.
LINGOW_AUTH_PEPPER=replace-with-a-separate-random-32-byte-or-longer-secret
# Raw URL-safe base64 for exactly 32 bytes (no '=' padding).
LINGOW_DESTINATION_KEY=replace-with-32-byte-raw-base64-key
# Phone verification stays disabled until a reviewed provider is configured.
# `mock-webhook` may be used only for local development; it POSTs {phone,code}
# to a local test receiver and never exposes codes through this API or logs.
LINGOW_APP_ENV=production
LINGOW_SMS_PROVIDER=disabled
LINGOW_SMS_WEBHOOK_URL=

LINGOW_API_IMAGE=lingow-member5-api:local
LINGOW_API_PORT=10080
LINGOW_TOKEN_ISSUER=lingow-api
LINGOW_TOKEN_AUDIENCE=lingow-client
LINGOW_DELIVERY_STREAM=lingow:delivery
LINGOW_DELIVERY_GROUP=delivery
LINGOW_API_CONSUMER=api
LINGOW_WORKER_CONSUMER=worker-1
# Keep this as `unconfigured` until an approved provider adapter is deployed.
# Use `wecom-bot` to enable account-specific enterprise WeChat group bots. Each
# bot URL is verified once and then encrypted in PostgreSQL; it is not an env var.
LINGOW_DELIVERY_PROVIDER=unconfigured
